# Use an official Node runtime as the base image
FROM node:22.14.0

# Set the working directory inside the container
WORKDIR /usr/src/app

# Copy package.json and package-lock.json first to leverage Docker cache
COPY apps/OpenSign/package*.json ./

# Install application dependencies
RUN npm install

# Copy the current directory contents into the container
COPY apps/OpenSign/ .
COPY apps/OpenSign/.husky .
COPY apps/OpenSign/entrypoint.sh .

# make the entrypoint.sh file executable
RUN chmod +x entrypoint.sh

# Define environment variables if needed
ENV NODE_ENV=production
ENV GENERATE_SOURCEMAP=false
# build
# SWURV: `npm run build` runs `npm run version` first, which curls the GitHub API
# for the latest release tag -- a network dependency that fails soft to an empty
# version.txt inside a Docker build. Pin it and invoke vite directly instead.
# Heap is capped at 3GB: this box's Docker VM is only 5.77GiB total and mostly
# committed to other services, so upstream's 8192 would risk an OOM kill.
RUN echo "v2.41.3" > ./public/version.txt \
 && NODE_OPTIONS="--max-old-space-size=3072" npx vite build

# Inject env.js loader into index.html
RUN sed -i '/<head>/a\<script src="/env.js"></script>' build/index.html

# Make port 3000 available to the world outside this container
EXPOSE 3000

ENTRYPOINT ["./entrypoint.sh"]

# Run the application
CMD ["npm", "start"]
